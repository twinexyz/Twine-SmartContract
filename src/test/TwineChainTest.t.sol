pragma solidity ^0.8.24;

import "forge-std/Test.sol";
import "forge-std/console.sol";

import {Types} from "../libraries/rlp/Types.sol";
import {TwineChain} from "../L1/rollup/TwineChain.sol";
import {ITwineChain} from "../L1/rollup/ITwineChain.sol";
import {L1MessageQueue} from "../L1/rollup/L1MessageQueue.sol";
import {RoleManager} from "../libraries/access/RoleManager.sol";
import {Upgrades} from "openzeppelin-foundry-upgrades/Upgrades.sol";
import {SP1Verifier} from "@sp1-contracts/v3.0.0/SP1VerifierGroth16.sol";

contract TwineChainTest is Test {
    RoleManager roleManager;
    TwineChain public twineChain;
    L1MessageQueue public messageQueue;
    
    address public verifier;
    address initialOwner = 0x19B78FF82C94b5E517f2279f3fBF10498B039179;
    bytes32 public constant CHAIN_ADMIN = keccak256("CHAIN_ADMIN");
    bytes32 public constant TWINE_OPERATIONS_HANDLER = keccak256("TWINE_OPERATIONS_HANDLER");
    

    function setUp() public {
        vm.startPrank(initialOwner);

        verifier = address(new SP1Verifier());

        address roleManagerAddress = Upgrades.deployTransparentProxy(
            "RoleManager.sol",
            msg.sender,
            abi.encodeCall(RoleManager.initialize, (initialOwner))
        );
        roleManager = RoleManager(roleManagerAddress);
        roleManager.grantRole(CHAIN_ADMIN, initialOwner);
        roleManager.grantRole(TWINE_OPERATIONS_HANDLER, initialOwner);

        // setup L1MessageQueue
        address L1MessageQueueAddress = Upgrades.deployTransparentProxy(
            "L1MessageQueue.sol",
            msg.sender,
            abi.encodeCall(
                L1MessageQueue.initialize,
                (0, address(0), address(roleManager))
            )
        );

        messageQueue = L1MessageQueue(L1MessageQueueAddress);

        // setup TwineChain
        address TwineChainAddress = Upgrades.deployTransparentProxy(
            "TwineChain.sol",
            msg.sender,
            abi.encodeCall(
                TwineChain.initialize,
                (address(messageQueue), verifier, address(roleManager))
            )
        );

        twineChain = TwineChain(TwineChainAddress);
    }

    function testFinalizationWithCommitment() public {

        ITwineChain.AccessList[] memory accessList = new ITwineChain.AccessList[](0); 
        
        ITwineChain.TransactionObject[] memory emptyTransactionObject = new ITwineChain.TransactionObject[](0);

        ITwineChain.TransactionObject memory depositTransactionObject = ITwineChain.TransactionObject({
            chainId: 1337,
            nonce: 11,
            maxPriorityFeePerGas: 2000000,
            maxFeePerGas: 20000000000,
            gas: 54011,
            to: 0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9,
            value: 0, 
            input: hex"",
            accesslist: accessList,
            v: 1,
            r: 0x7d3f7d7aa870674bba8a87016a512d8aed6bc520336d1313a8d6f206548d2a06,
            s: 0x07bdc312417b4107d60b693f7d86ed759ae1bc1d0a6612479bfb45fb67150516  
        });

        ITwineChain.TransactionObject[] memory depositTransactionArray = new ITwineChain.TransactionObject[](1);
        depositTransactionArray[0] = depositTransactionObject;

        ITwineChain.CommitBatchInfo memory commitInfo = ITwineChain.CommitBatchInfo({
            batchNumber: 703,
            batchHash: 0x7e092780932eed98ecf71ba7ba4152ac470a58fa37256742f09b8994d8677f52,
            previousStateRoot: 0x6ba4e55f69c3b7d8a451a3695d91214decaec10ad74553f77acd852875022ddd ,
            stateRoot: 0x50947d76e553fff7120540097ecff5731a91f121903c309b553fe9f842628bcf,
            transactionRoot: 0x111eb09ebd09d3e28793225d7193500bc65d396d1d1ed1e2707fb37f0d5e6ae5,
            receiptRoot: 0x00e9c139debae1d63dafd5d32abc4335e15a57037ebc39c181ec9ad426d88e28,
            depositTransactionObject: depositTransactionArray,
            forcedTransactionObjects: emptyTransactionObject,
            otherTransactions: emptyTransactionObject
        });

        bytes32 vkey = 0x00b2ae7696b3267ee6284fe116b7b542d4248a1c0c33cd675be0e9a8672ce05a;
        bytes memory _proofBytes = hex"";
        bytes memory prependedProof = twineChain.perpendBytes(_proofBytes);
        vm.startPrank(initialOwner);
        twineChain.setProgramVKey(vkey);

        vm.startPrank(initialOwner);
        uint256 gasStart = gasleft();
        twineChain.commitBatch(commitInfo);
        uint256 gasEnd = gasleft();
        console.log("Commit Batch gas used :",gasStart - gasEnd);
        assertEq(twineChain.lastCommittedBatchNumber(), 703);
        uint256 gasStarts = gasleft();
        twineChain.finalizeBatch(703, prependedProof);
        uint256 gasEnds = gasleft();
        console.log("Finalize Batch gas used :",gasStarts - gasEnds);
        assertEq(twineChain.lastFinalizedBatchNumber(), 703);
    }

     function testTransactionObjectRlpEncoding() public view {
        ITwineChain.AccessList[] memory accessListArray = new ITwineChain.AccessList[](0);
        ITwineChain.TransactionObject memory _transactionObject = ITwineChain.TransactionObject({
                chainId: 1337,
                nonce: 11,
                gas: 54011,
                maxPriorityFeePerGas: 2000000,
                maxFeePerGas: 20000000000,
                to: 0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9,
                value: 0,
                input: hex"",
                accesslist: accessListArray,
                v: 1,
                r: 0x7d3f7d7aa870674bba8a87016a512d8aed6bc520336d1313a8d6f206548d2a06,
                s: 0x07bdc312417b4107d60b693f7d86ed759ae1bc1d0a6612479bfb45fb67150516
            });
            
        assertEq(
            0x42ed6dce6384c126c301be1e0b2f2aaae9dd1a99f66c9e74fc25b0b351636cf2,
            twineChain.getTransactinObjectRLP(_transactionObject)
        );
    }
}
