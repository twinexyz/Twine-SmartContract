pragma solidity ^0.8.24;

import "forge-std/Test.sol";
import "./MPTProofHelper.sol";

contract MPTReceiptVerification is Test {
    MPTProofHelper verifier;

    function setUp() public {
        verifier = new MPTProofHelper();
    }

    function testReceiptProof() public view {
        // This data is from ethereum height 21077516 and receipt index 29
        bytes memory proof = hex"";
        bytes32 root = hex"9c5925245db5d0a87e235b3e582d2fe6407b61ba16d88bb68614b016f5ec4b64";
        bytes memory key = hex"010e";
        bytes memory value = hex"";

        bytes memory res = verifier.verifyRLPProof(
            proof,
            root,
            key
        );
        assertEq(value, res);
    }
}